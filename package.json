{
  "name": "vcp-mobile",
  "private": true,
  "version": "1.1.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "io:write": "node scripts/nova_utils.cjs write",
    "io:append": "node scripts/nova_utils.cjs append",
    "memory:refresh": "node scripts/refresh_manifest.cjs",
    "check": "pnpm check:csp && vue-tsc --noEmit && cd src-tauri && cargo check",
    "test:renderer": "vitest run src/core/utils/renderDocument.spec.ts src/core/utils/htmlActions.spec.ts src/core/composables/useMessageStyleInjector.spec.ts src/core/composables/useChatScroll.spec.ts src/core/composables/useRenderVisibility.spec.ts src/core/utils/activeHtmlSandbox.spec.ts src/core/utils/auroraStream.spec.ts",
    "check:csp": "node tools/verify_tauri_csp.cjs",
    "android:kotlin:check": "node tools/android_kotlin_check.cjs",
    "android:arm64:release": "node scripts/build_android_arm64_release.cjs",
    "android:arm64:release:tauri": "tauri android build --target aarch64 --apk --split-per-abi --ci",
    "android:x86_64:release": "node scripts/build_android_arm64_release.cjs --target x86_64",
    "android:arm64:debug": "tauri android build --debug --target aarch64 --apk --split-per-abi --ci",
    "sccache:stats": "sccache --show-stats",
    "dev:android": "node scripts/tauri_android_dev.cjs",
    "dev:usb": "node scripts/tauri_android_dev.cjs --usb"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.0",
    "@tauri-apps/plugin-opener": "2.5.4",
    "@vueuse/core": "^14.2.1",
    "css-tree": "3.2.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.2",
    "katex": "^0.16.45",
    "lucide-vue-next": "^0.576.0",
    "marked": "^18.0.4",
    "markstream-vue": "1.0.7",
    "mermaid": "^11.14.0",
    "morphdom": "^2.7.8",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "sortablejs": "^1.15.7",
    "tauri-plugin-vcp-mobile": "file:src-tauri/plugins/vcp-mobile",
    "vue": "^3.5.33",
    "vue-cropper": "^1.1.4",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/ph": "^1.2.2",
    "@pinia/testing": "^1.0.3",
    "@tauri-apps/cli": "2.11.2",
    "@types/css-tree": "^2.3.11",
    "@types/katex": "^0.16.8",
    "@types/sortablejs": "^1.15.9",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@unocss/preset-attributify": "^66.6.8",
    "@unocss/preset-typography": "^66.6.8",
    "@unocss/preset-uno": "^66.6.8",
    "@unocss/reset": "^66.6.8",
    "@unocss/transformer-directives": "^66.6.8",
    "@unocss/transformer-variant-group": "^66.6.8",
    "@unocss/vite": "^66.6.8",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^4.1.9",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-vue": "^10.9.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "typescript": "~5.6.3",
    "unocss": "^66.6.8",
    "vite": "^6.4.2",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.2.12"
  }
}
